APP_NAME="School SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

APP_TIMEZONE=Asia/Jakarta

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────
# Docker Compose
# ──────────────────────────────────────────────
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
UID=1000
GID=1000

# ──────────────────────────────────────────────
# Forwarded Ports (host -> container)
# Change these if ports conflict on your machine
# ──────────────────────────────────────────────
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=63790
FORWARD_MEILISEARCH_PORT=7700
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ──────────────────────────────────────────────
# Database (PostgreSQL 16)
# ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school
DB_USERNAME=school
DB_PASSWORD=secret

# ──────────────────────────────────────────────
# Session
# ──────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ──────────────────────────────────────────────
# Broadcasting / Queue / Cache
# ──────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# ──────────────────────────────────────────────
# Redis 7
# ──────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

# ──────────────────────────────────────────────
# Meilisearch
# ──────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

# ──────────────────────────────────────────────
# MinIO (S3-compatible local storage)
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=school
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ──────────────────────────────────────────────
# Mail (Mailpit in development)
# ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@school.test"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Reverb (WebSocket)
# ──────────────────────────────────────────────
REVERB_APP_ID=175173
REVERB_APP_KEY=trdserhatsauwqmocbsp
REVERB_APP_SECRET=uo1ua2hcdfm6vxg3oozq
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# ──────────────────────────────────────────────
# Vite (Docker HMR)
# ──────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ──────────────────────────────────────────────
# Debug (development only)
# ──────────────────────────────────────────────
XDEBUG_MODE=off
